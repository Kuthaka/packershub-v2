---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import StatsRow from '../components/StatsRow.astro';
import Services from '../components/Services.astro';
import RoutesSection from '../components/RoutesSection.astro';
import WhyUs from '../components/WhyUs.astro';
import Locations from '../components/Locations.astro';
import Pricing from '../components/Pricing.astro';
import Testimonials from '../components/Testimonials.astro';
import FAQ from '../components/FAQ.astro';
import CTABand from '../components/CTABand.astro';
import Footer from '../components/Footer.astro';
import FloatingActions from '../components/FloatingActions.astro';
---

<Layout>
	<Header />
	<main>
		<Hero />
		<StatsRow />
		<Services />
		<RoutesSection />
		<WhyUs />
		<Locations />
		<Pricing />
		<Testimonials />
		<FAQ />
		<CTABand />
	</main>
	<Footer />
	<FloatingActions />
</Layout>

<style>
	main {
		overflow-x: hidden;
	}
</style>
