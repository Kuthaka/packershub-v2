---
---
<section class="pricing-section" id="pricing">
  <div class="container">
    <div class="pricing-card animate-fadeUp">
      <div class="p-header">
        <div>
          <h3>Standard Moving Prices</h3>
          <p>Estimated costs for local shifting within the same city.</p>
        </div>
        <div class="p-badge">IBA Approved Rates</div>
      </div>
      
      <div class="p-list">
        <div class="p-item">
          <div class="p-info">
            <span class="p-icon">🏠</span>
            <div>
              <div class="p-name">1 BHK Shifting</div>
              <div class="p-meta">Small truck + 2 Packers</div>
            </div>
          </div>
          <div class="p-val">From ₹3,999</div>
        </div>
        <div class="p-item">
          <div class="p-info">
            <span class="p-icon">🏡</span>
            <div>
              <div class="p-name">2 BHK Shifting</div>
              <div class="p-meta">Medium truck + 3 Packers</div>
            </div>
          </div>
          <div class="p-val">From ₹6,499</div>
        </div>
        <div class="p-item">
          <div class="p-info">
            <span class="p-icon">🏰</span>
            <div>
              <div class="p-name">3 BHK Shifting</div>
              <div class="p-meta">Large truck + 4 Packers</div>
            </div>
          </div>
          <div class="p-val">From ₹9,999</div>
        </div>
        <div class="p-item">
          <div class="p-info">
            <span class="p-icon">🏢</span>
            <div>
              <div class="p-name">Office Relocation</div>
              <div class="p-meta">Custom planning & execution</div>
            </div>
          </div>
          <div class="p-val">Custom Quote</div>
        </div>
        <div class="p-item">
          <div class="p-info">
            <span class="p-icon">🚗</span>
            <div>
              <div class="p-name">Vehicle Transport</div>
              <div class="p-meta">Car/Bike in enclosed carrier</div>
            </div>
          </div>
          <div class="p-val">From ₹1,999</div>
        </div>
      </div>
      
      <div class="p-footer">
        * Final price depends on the exact distance, floor level, and packing requirements. 
        <a href="tel:+917731074075">Call for Free Survey</a>
      </div>
    </div>
  </div>
</section>

<style>
  .pricing-section { padding: 80px 0; background: var(--bg); }
  .pricing-card {
    background: #fff;
    border-radius: var(--radius-xl);
    border: 1.5px solid var(--border);
    overflow: hidden;
    max-width: 900px;
    margin: 0 auto;
    box-shadow: var(--shadow-lg);
  }
  .p-header {
    background: var(--primary-light);
    padding: 32px 40px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1.5px solid var(--border);
  }
  .p-header h3 {
    font-family: var(--font-display);
    font-size: 24px;
    font-weight: 800;
    color: var(--text-primary);
  }
  .p-header p {
    font-size: 14px;
    color: var(--text-secondary);
    margin-top: 4px;
  }
  .p-badge {
    background: #fff;
    padding: 6px 14px;
    border-radius: 100px;
    font-size: 12px;
    font-weight: 700;
    color: var(--primary);
    border: 1px solid var(--primary);
  }
  
  .p-list { padding: 8px 0; }
  .p-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 24px 40px;
    border-bottom: 1px solid var(--border);
    transition: background 0.2s;
  }
  .p-item:last-child { border-bottom: none; }
  .p-item:hover { background: var(--bg-section); }
  
  .p-info { display: flex; align-items: center; gap: 20px; }
  .p-icon { font-size: 28px; }
  .p-name {
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 700;
    color: var(--text-primary);
  }
  .p-meta {
    font-size: 13px;
    color: var(--text-muted);
    margin-top: 2px;
  }
  .p-val {
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 800;
    color: var(--text-primary);
  }
  
  .p-footer {
    padding: 24px 40px;
    background: var(--bg-section);
    font-size: 13px;
    color: var(--text-muted);
    text-align: center;
  }
  .p-footer a {
    color: var(--primary);
    font-weight: 700;
    margin-left: 8px;
    text-decoration: underline;
  }

  @media (max-width: 600px) {
    .p-header { padding: 24px; flex-direction: column; align-items: flex-start; gap: 16px; }
    .p-item { padding: 20px 24px; flex-direction: column; align-items: flex-start; gap: 12px; }
    .p-val { font-size: 16px; color: var(--primary); }
    .p-footer { padding: 20px 24px; }
  }
</style>
