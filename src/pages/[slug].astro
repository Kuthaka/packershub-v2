---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import QuoteForm from '../components/QuoteForm.astro';
import Services from '../components/Services.astro';
import Process from '../components/Process.astro';
import WhyUs from '../components/WhyUs.astro';
import FAQ from '../components/FAQ.astro';
import Footer from '../components/Footer.astro';
import FloatingActions from '../components/FloatingActions.astro';
import { locations } from '../data/locations';

export async function getStaticPaths() {
  return locations.map((loc) => ({
    params: { slug: loc.slug },
    props: { location: loc },
  }));
}

const { location } = Astro.props;
const isState = location.type === 'state';

// Filter cities if it's a state page
const stateCities = isState 
  ? locations.filter(l => l.type === 'city' && l.state === location.name)
  : [];

const title = `Packers and Movers in ${location.name} | ${location.tagline} | PackersHub`;
const description = `Looking for the best packers and movers in ${location.name}? PackersHub offers professional ${location.tagline} relocation services with 100% safety and transparency.`;
---

<Layout title={title} description={description}>
  <Header />
  <main>
    <!-- Dynamic Hero -->
    <section class="loc-hero">
      <div class="container">
        <div class="loc-hero-content animate-fadeUp">
          <div class="loc-badge">
            <span class="dot"></span>
            Professional Movers in {location.name}
          </div>
          <h1>
            Best Packers and Movers in <span class="text-gradient-primary">{location.name}</span>
          </h1>
          <p class="tagline">{location.tagline}</p>
          <p class="description">
            Experience world-class relocation services in {location.name}. Whether it's household shifting, 
            office moving, or vehicle transport, PackersHub ensures a stress-free experience 
            with our {isState ? 'state-wide' : 'city-wide'} network.
          </p>
          <div class="loc-cta">
            <a href="#quote" class="btn btn-primary btn-lg">Get Free Quote</a>
            <a href="tel:+917731074075" class="btn btn-outline btn-lg">Call Expert</a>
          </div>
        </div>
      </div>
    </section>

    <QuoteForm />
    
    {isState && (
      <section class="cities-section section">
        <div class="container">
          <div class="section-header text-center animate-fadeUp">
            <h2 class="heading-lg">Cities we serve in <span class="text-gradient-primary">{location.name}</span></h2>
            <p>Providing professional moving services across all major hubs in the state.</p>
          </div>
          <div class="city-grid">
            {stateCities.map(city => (
              <a href={`/${city.slug}/`} class="city-card animate-fadeUp">
                <div class="city-info">
                  <span class="city-name">{city.name}</span>
                  <span class="city-tag">{city.tagline}</span>
                </div>
                <span class="arrow">→</span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    <Services />
    <Process />
    <WhyUs />
    <FAQ />
  </main>
  <Footer />
  <FloatingActions />
</Layout>

<style>
  .loc-hero {
    padding: 120px 0 80px;
    background: linear-gradient(135deg, var(--primary-light) 0%, #fff 100%);
    text-align: center;
  }
  .loc-hero-content {
    max-width: 800px;
    margin: 0 auto;
  }
  .loc-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #fff;
    padding: 8px 20px;
    border-radius: 100px;
    font-size: 14px;
    font-weight: 700;
    color: var(--primary);
    box-shadow: 0 4px 15px rgba(0,0,0,0.05);
    margin-bottom: 24px;
  }
  .dot {
    width: 8px;
    height: 8px;
    background: var(--success);
    border-radius: 50%;
  }
  .loc-hero h1 {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 800;
    line-height: 1.1;
    margin-bottom: 20px;
    color: var(--text-primary);
  }
  .tagline {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--accent);
    margin-bottom: 16px;
    font-family: var(--font-display);
  }
  .description {
    font-size: 1.1rem;
    color: var(--text-secondary);
    margin-bottom: 40px;
    line-height: 1.6;
  }
  .loc-cta {
    display: flex;
    gap: 20px;
    justify-content: center;
    flex-wrap: wrap;
  }
  .btn-outline {
    background: transparent;
    border: 2px solid var(--primary);
    color: var(--primary);
  }

  /* Cities Grid */
  .cities-section {
    background: var(--bg-section);
  }
  .city-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 20px;
    margin-top: 50px;
  }
  .city-card {
    background: #fff;
    padding: 24px;
    border-radius: var(--radius-md);
    display: flex;
    justify-content: space-between;
    align-items: center;
    text-decoration: none;
    transition: var(--transition);
    border: 1px solid var(--border);
  }
  .city-card:hover {
    transform: translateY(-5px);
    border-color: var(--primary);
    box-shadow: var(--shadow-md);
  }
  .city-info {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .city-name {
    font-size: 18px;
    font-weight: 700;
    color: var(--text-primary);
  }
  .city-tag {
    font-size: 13px;
    color: var(--text-muted);
  }
  .arrow {
    font-size: 20px;
    color: var(--primary);
    opacity: 0.5;
    transition: 0.3s;
  }
  .city-card:hover .arrow {
    opacity: 1;
    transform: translateX(5px);
  }

  @media (max-width: 768px) {
    .loc-hero { padding: 80px 0 60px; }
    .city-grid { grid-template-columns: 1fr; }
  }
</style>
