---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import QuoteForm from '../components/QuoteForm.astro';
import Services from '../components/Services.astro';
import Process from '../components/Process.astro';
import WhyUs from '../components/WhyUs.astro';
import FAQ from '../components/FAQ.astro';
import Footer from '../components/Footer.astro';
import FloatingActions from '../components/FloatingActions.astro';
import { locations } from '../data/locations';
import { stateData } from '../data/states';
import { cityAPData } from '../data/city-ap';
import { cityTGData } from '../data/city-tg';
import { cityTNData } from '../data/city-tn';
import { cityKAData } from '../data/city-ka';
import { cityKLData } from '../data/city-kl';
import type { StateContent, CityContent } from '../data/types';

export async function getStaticPaths() {
  return locations.map((loc) => ({
    params: { slug: loc.slug },
    props: { location: loc },
  }));
}

const { location } = Astro.props;
const isState = location.type === 'state';

// Combine all city data sources
const allCityData = { 
  ...cityAPData, 
  ...cityTGData, 
  ...cityTNData, 
  ...cityKAData, 
  ...cityKLData 
};
const content = isState ? stateData[location.slug] : allCityData[location.slug];

// Type-safe access
const stateContent = isState ? content as StateContent : null;
const cityContent = !isState ? content as CityContent : null;

// Filter cities if it's a state page
const stateCities = isState 
  ? locations.filter(l => l.type === 'city' && l.state === location.name)
  : [];

const title = content?.metaTitle || `Packers and Movers in ${location.name} | ${location.tagline} | PackersHub`;
const description = content?.metaDescription || `Looking for the best packers and movers in ${location.name}? PackersHub offers professional ${location.tagline} relocation services in ${location.name} with 100% safety and transparency.`;
---

<Layout title={title} description={description}>
  <Header />
  <main>
    <!-- Dynamic Hero -->
    <section class="loc-hero">
      <div class="container">
        <div class="loc-hero-content animate-fadeUp">
          <div class="loc-badge">
            <span class="dot"></span>
            Professional Movers in {location.name}
          </div>
          <h1>
            {content ? content.title : `Best Packers and Movers in ${location.name}`}
          </h1>
          {content ? (
             <p class="intro-text">{content.introduction}</p>
          ) : (
            <>
              <p class="tagline">{location.tagline}</p>
              <p class="description">
                Experience world-class relocation services in {location.name}. Whether it's household shifting, 
                office moving, or vehicle transport, PackersHub ensures a stress-free experience 
                with our city-wide network.
              </p>
            </>
          )}
          <div class="loc-cta">
            <a href="#quote" class="btn btn-primary btn-lg">Get Free Quote</a>
            <a href={`tel:${content?.cta.phone || '+917731074075'}`} class="btn btn-outline btn-lg">Call Expert</a>
          </div>
        </div>
      </div>
    </section>

    <QuoteForm />
    
    {isState && stateContent && (
      <>
        <!-- State sections (already implemented) -->
        <section class="state-services section">
          <div class="container">
            <div class="section-header text-center animate-fadeUp">
              <h2 class="heading-lg">{stateContent.services.title}</h2>
            </div>
            <div class="services-rich-grid">
              {stateContent.services.items.map(item => {
                const [title, desc] = item.split(': ');
                return (
                  <div class="service-rich-card animate-fadeUp">
                    <h3>{title}</h3>
                    <p>{desc}</p>
                  </div>
                );
              })}
            </div>
          </div>
        </section>

        <section class="why-state section">
          <div class="container">
            <div class="why-grid">
              <div class="why-content animate-fadeUp">
                <h2 class="heading-lg">{stateContent.whyUs.title}</h2>
                <p>{stateContent.whyUs.content}</p>
                <div class="fact-box">
                  <span class="fact-icon">ℹ️</span>
                  <p>{stateContent.whyUs.fact}</p>
                </div>
              </div>
            </div>
          </div>
        </section>

        <section class="process-state section">
          <div class="container">
            <div class="section-header text-center animate-fadeUp">
              <h2 class="heading-lg">{stateContent.process.title}</h2>
            </div>
            <div class="process-steps">
              {stateContent.process.steps.map(step => (
                <div class="step-card animate-fadeUp">
                  <div class="step-number">{step.step.split(' ')[1]}</div>
                  <h4>{step.step.split(' — ')[1]}</h4>
                  <p>{step.text}</p>
                </div>
              ))}
            </div>
          </div>
        </section>

        <section class="cities-section section">
          <div class="container">
            <div class="section-header text-center animate-fadeUp">
              <h2 class="heading-lg">Cities we serve in <span class="text-gradient-primary">{location.name}</span></h2>
              <p>Providing professional moving services across all major hubs in the state.</p>
            </div>
            <div class="city-grid">
              {stateCities.map(city => (
                <a href={`/${city.slug}/`} class="city-card animate-fadeUp">
                  <div class="city-info">
                    <span class="city-name">{city.name}</span>
                    <span class="city-tag">{city.tagline}</span>
                  </div>
                  <span class="arrow">→</span>
                </a>
              ))}
            </div>
          </div>
        </section>

        <section class="faq-state section">
          <div class="container">
            <div class="section-header text-center animate-fadeUp">
              <h2 class="heading-lg">Frequently Asked Questions</h2>
            </div>
            <div class="faq-list">
              {stateContent.faqs.map(faq => (
                <div class="faq-item animate-fadeUp">
                  <h4>{faq.q}</h4>
                  <p>{faq.a}</p>
                </div>
              ))}
            </div>
          </div>
        </section>
      </>
    )}

    {!isState && cityContent && (
      <>
        <section class="city-info-section section">
          <div class="container">
            <div class="city-info-grid">
              <div class="info-card animate-fadeUp">
                <h3>City Statistics</h3>
                <ul>
                  <li><strong>District:</strong> {cityContent.cityInfo.district}</li>
                  <li><strong>Population:</strong> {cityContent.cityInfo.population}</li>
                </ul>
              </div>
              <div class="info-card animate-fadeUp">
                <h3>Key Landmarks</h3>
                <div class="landmark-tags">
                  {cityContent.cityInfo.landmarks.map((l: string) => <span class="tag">{l}</span>)}
                </div>
              </div>
            </div>
          </div>
        </section>

        <section class="local-context section bg-light">
          <div class="container">
            <div class="section-header animate-fadeUp">
              <h2 class="heading-lg">{cityContent.localContext.title}</h2>
              <p>{cityContent.localContext.description}</p>
            </div>
            <div class="common-moves-grid">
              {cityContent.localContext.commonMoves.map((move: string) => (
                <div class="move-item animate-fadeUp">
                  <span class="check">✓</span>
                  <p>{move}</p>
                </div>
              ))}
            </div>
            <div class="active-areas animate-fadeUp">
              <h4>Active Neighborhoods</h4>
              <p>{cityContent.localContext.activeAreas}</p>
            </div>
          </div>
        </section>

        <section class="pricing-section section">
          <div class="container">
            <div class="section-header text-center animate-fadeUp">
              <h2 class="heading-lg">{cityContent.pricingGuide.title}</h2>
            </div>
            <div class="pricing-grid">
              <div class="price-box animate-fadeUp">
                <h4>Local Shifting</h4>
                <div class="price">{cityContent.pricingGuide.typicalCosts.local}</div>
              </div>
              <div class="price-box animate-fadeUp">
                <h4>Long Distance</h4>
                <div class="price">{cityContent.pricingGuide.typicalCosts.longDistance}</div>
              </div>
            </div>
            <div class="pricing-details animate-fadeUp">
              <p><strong>Note:</strong> {cityContent.pricingGuide.note}</p>
              <p><strong>Vehicles:</strong> {cityContent.pricingGuide.vehicleTransport}</p>
            </div>
          </div>
        </section>

        <section class="state-services section">
          <div class="container">
            <div class="section-header text-center animate-fadeUp">
              <h2 class="heading-lg">{cityContent.services.title}</h2>
            </div>
            <div class="services-rich-grid">
              {cityContent.services.items.map(item => {
                const [title, desc] = item.split(': ');
                return (
                  <div class="service-rich-card animate-fadeUp">
                    <h3>{title}</h3>
                    <p>{desc}</p>
                  </div>
                );
              })}
            </div>
          </div>
        </section>

        <section class="faq-state section">
          <div class="container">
            <div class="section-header text-center animate-fadeUp">
              <h2 class="heading-lg">FAQs for {location.name}</h2>
            </div>
            <div class="faq-list">
              {cityContent.faqs.map(faq => (
                <div class="faq-item animate-fadeUp">
                  <h4>{faq.q}</h4>
                  <p>{faq.a}</p>
                </div>
              ))}
            </div>
          </div>
        </section>
      </>
    )}

    {!content && (
      <>
        <Services />
        <Process />
        <WhyUs />
        <FAQ />
      </>
    )}
  </main>
  <Footer />
  <FloatingActions />
</Layout>

<style>
  .intro-text {
    font-size: 1.1rem;
    color: var(--text-secondary);
    margin-bottom: 40px;
    line-height: 1.8;
    white-space: pre-wrap;
    max-width: 900px;
    margin-left: auto;
    margin-right: auto;
  }

  /* Rich Services Grid */
  .services-rich-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 30px;
    margin-top: 50px;
  }
  .service-rich-card {
    background: #fff;
    padding: 32px;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    transition: var(--transition);
    text-align: left;
  }
  .service-rich-card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-lg);
    border-color: var(--primary);
  }
  .service-rich-card h3 {
    font-size: 20px;
    font-weight: 800;
    margin-bottom: 16px;
    color: var(--primary);
    font-family: var(--font-display);
  }
  .service-rich-card p {
    font-size: 15px;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  /* Fact Box */
  .fact-box {
    margin-top: 30px;
    padding: 24px;
    background: var(--primary-light);
    border-radius: var(--radius-md);
    display: flex;
    gap: 16px;
    align-items: flex-start;
    border-left: 4px solid var(--primary);
    text-align: left;
  }
  .fact-icon { font-size: 24px; }
  .fact-box p {
    font-size: 15px;
    font-weight: 600;
    color: var(--primary);
    margin: 0;
  }

  /* Process Steps */
  .process-steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 30px;
    margin-top: 50px;
  }
  .step-card {
    background: #fff;
    padding: 32px;
    border-radius: var(--radius-lg);
    position: relative;
    border: 1px solid var(--border);
    text-align: left;
  }
  .step-number {
    width: 40px; height: 40px;
    background: var(--primary);
    color: #fff;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    margin-bottom: 20px;
  }
  .step-card h4 {
    font-size: 18px;
    font-weight: 800;
    margin-bottom: 12px;
    font-family: var(--font-display);
  }
  .step-card p {
    font-size: 14px;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  /* FAQ List */
  .faq-list {
    max-width: 800px;
    margin: 40px auto 0;
    display: flex;
    flex-direction: column;
    gap: 20px;
    text-align: left;
  }
  .faq-item {
    background: #fff;
    padding: 24px;
    border-radius: var(--radius-md);
    border: 1px solid var(--border);
  }
  .faq-item h4 {
    font-size: 17px;
    font-weight: 800;
    margin-bottom: 10px;
    color: var(--text-primary);
    font-family: var(--font-display);
  }
  .faq-item p {
    font-size: 15px;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .loc-hero {
    padding: 120px 0 80px;
    background: linear-gradient(135deg, var(--primary-light) 0%, #fff 100%);
    text-align: center;
  }
  .loc-hero-content {
    max-width: 800px;
    margin: 0 auto;
  }
  .loc-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #fff;
    padding: 8px 20px;
    border-radius: 100px;
    font-size: 14px;
    font-weight: 700;
    color: var(--primary);
    box-shadow: 0 4px 15px rgba(0,0,0,0.05);
    margin-bottom: 24px;
  }
  .dot {
    width: 8px;
    height: 8px;
    background: var(--success);
    border-radius: 50%;
  }
  .loc-hero h1 {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 800;
    line-height: 1.1;
    margin-bottom: 20px;
    color: var(--text-primary);
  }
  .tagline {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--accent);
    margin-bottom: 16px;
    font-family: var(--font-display);
  }
  .description {
    font-size: 1.1rem;
    color: var(--text-secondary);
    margin-bottom: 40px;
    line-height: 1.6;
  }
  .loc-cta {
    display: flex;
    gap: 20px;
    justify-content: center;
    flex-wrap: wrap;
  }
  .btn-outline {
    background: transparent;
    border: 2px solid var(--primary);
    color: var(--primary);
  }

  /* Cities Grid */
  .cities-section {
    background: var(--bg-section);
  }
  .city-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 20px;
    margin-top: 50px;
  }
  .city-card {
    background: #fff;
    padding: 24px;
    border-radius: var(--radius-md);
    display: flex;
    justify-content: space-between;
    align-items: center;
    text-decoration: none;
    transition: var(--transition);
    border: 1px solid var(--border);
  }
  .city-card:hover {
    transform: translateY(-5px);
    border-color: var(--primary);
    box-shadow: var(--shadow-md);
  }
  .city-info {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .city-name {
    font-size: 18px;
    font-weight: 700;
    color: var(--text-primary);
  }
  .city-tag {
    font-size: 13px;
    color: var(--text-muted);
  }
  .arrow {
    font-size: 20px;
    color: var(--primary);
    opacity: 0.5;
    transition: 0.3s;
  }
  .city-card:hover .arrow {
    opacity: 1;
    transform: translateX(5px);
  }

  /* City Specific Styles */
  .city-info-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 30px;
  }
  .info-card {
    background: #fff;
    padding: 30px;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    text-align: left;
  }
  .info-card h3 {
    font-size: 20px;
    margin-bottom: 20px;
    color: var(--primary);
    font-family: var(--font-display);
  }
  .info-card ul {
    list-style: none;
    padding: 0;
  }
  .info-card li {
    margin-bottom: 12px;
    font-size: 16px;
    color: var(--text-secondary);
  }
  .landmark-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .tag {
    background: var(--primary-light);
    color: var(--primary);
    padding: 6px 16px;
    border-radius: 100px;
    font-size: 13px;
    font-weight: 700;
  }

  .bg-light { background: var(--bg-section); }
  
  .common-moves-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 20px;
    margin: 30px 0;
  }
  .move-item {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    padding: 16px;
    background: #fff;
    border-radius: var(--radius-md);
    border: 1px solid var(--border);
    text-align: left;
  }
  .move-item .check {
    color: var(--success);
    font-weight: bold;
  }
  .active-areas {
    margin-top: 30px;
    padding: 24px;
    background: #fff;
    border-radius: var(--radius-md);
    border: 1px solid var(--border);
    text-align: left;
  }
  .active-areas h4 {
    margin-bottom: 12px;
    color: var(--text-primary);
  }

  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 24px;
    margin: 40px 0;
  }
  .price-box {
    background: #fff;
    padding: 30px;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    text-align: center;
    transition: var(--transition);
  }
  .price-box:hover {
    border-color: var(--primary);
    transform: translateY(-5px);
  }
  .price-box h4 {
    font-size: 16px;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 16px;
    color: var(--text-secondary);
  }
  .price {
    font-size: 24px;
    font-weight: 800;
    color: var(--primary);
  }
  .pricing-details {
    max-width: 700px;
    margin: 0 auto;
    text-align: center;
    color: var(--text-secondary);
    font-size: 15px;
    line-height: 1.6;
  }

  @media (max-width: 768px) {
    .loc-hero { padding: 80px 0 60px; }
    .city-grid { grid-template-columns: 1fr; }
  }
</style>
