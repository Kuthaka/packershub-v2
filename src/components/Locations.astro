---
import { locations } from '../data/locations';
---
<section class="locations-section" id="locations">
  <div class="container">
    <div class="section-header animate-fadeUp">
      <div class="chip">📍 Service Network</div>
      <h2>Serving 75+ Cities Across 5 States</h2>
      <p>South India's largest relocation network. Professional movers near you.</p>
    </div>

    <div class="states-tabs animate-fadeUp">
      {locations.map((state, index) => (
        <button class={`state-tab ${index === 0 ? 'active' : ''}`} data-state={state.state.toLowerCase().replace(/ /g, '-')}>
          {state.state} ({state.cities.length})
        </button>
      ))}
    </div>

    {locations.map((state, index) => (
      <div class={`cities-panel ${index === 0 ? 'active' : ''}`} id={`state-${state.state.toLowerCase().replace(/ /g, '-')}`}>
        <div class="cities-grid">
          {state.cities.map(city => (
            <a href={`/packers-and-movers-in-${city.name.toLowerCase().replace(/ /g, '-')}`} class="city-card">
              <div class="city-info">
                <span class="city-dot"></span>
                <span class="city-name">{city.name}</span>
              </div>
              <span class="city-arrow">→</span>
            </a>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .locations-section { padding: 80px 0; background: var(--bg-section); }
  .section-header { text-align: center; margin-bottom: 40px; }
  
  .states-tabs {
    display: flex;
    gap: 10px;
    margin-bottom: 40px;
    flex-wrap: wrap;
    justify-content: center;
  }
  .state-tab {
    padding: 10px 24px;
    border-radius: 100px;
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 700;
    color: var(--text-secondary);
    background: #fff;
    border: 1.5px solid var(--border);
    cursor: pointer;
    transition: var(--transition);
  }
  .state-tab:hover { border-color: var(--primary); color: var(--primary); }
  .state-tab.active {
    background: var(--primary);
    color: #fff;
    border-color: var(--primary);
    box-shadow: var(--shadow-md);
  }

  .cities-panel { display: none; }
  .cities-panel.active { display: block; animation: fadeIn 0.4s ease; }

  .cities-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }
  .city-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 20px;
    background: #fff;
    border: 1.5px solid var(--border);
    border-radius: 12px;
    text-decoration: none;
    transition: all 0.3s;
  }
  .city-card:hover {
    border-color: var(--primary);
    background: var(--primary-light);
    transform: translateY(-2px);
  }
  .city-info { display: flex; align-items: center; gap: 10px; }
  .city-dot { width: 6px; height: 6px; background: var(--primary); border-radius: 50%; opacity: 0.5; }
  .city-name { font-weight: 600; color: var(--text-primary); font-size: 14px; }
  .city-arrow { color: var(--text-muted); font-size: 14px; }

  @media (max-width: 1024px) {
    .cities-grid { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 768px) {
    .cities-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 480px) {
    .cities-grid { grid-template-columns: 1fr; }
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>

<script>
  const tabs = document.querySelectorAll('.state-tab');
  const panels = document.querySelectorAll('.cities-panel');

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      const stateId = tab.getAttribute('data-state');
      
      tabs.forEach(t => t.classList.remove('active'));
      panels.forEach(p => p.classList.remove('active'));
      
      tab.classList.add('active');
      document.getElementById(`state-${stateId}`)?.classList.add('active');
    });
  });
</script>
