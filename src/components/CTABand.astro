<section class="cta-banner">
  <div class="container">
    <div class="cta-inner animate-fadeUp">
      <h2>Experience a Stress-Free Move Today</h2>
      <p>Join 50,000+ happy families who moved with PackersHub. Get your free, no-obligation quote in 60 seconds.</p>
      <div class="cta-btns">
        <a href="tel:+917731074075" class="btn btn-primary btn-lg">📞 Call +91 77310 74075</a>
        <a href="https://wa.me/917731074075" class="btn btn-accent btn-lg" target="_blank">💬 WhatsApp Now</a>
      </div>
    </div>
  </div>
</section>

<style>
  .cta-banner { padding: 80px 0; background: #fff; }
  .cta-inner {
    background: linear-gradient(135deg, var(--primary-dark) 0%, #1e1b4b 100%);
    border-radius: var(--radius-xl);
    padding: 64px 40px;
    text-align: center;
    color: #fff;
    box-shadow: var(--shadow-lg);
  }
  .cta-inner h2 {
    font-family: var(--font-display);
    font-size: clamp(28px, 4vw, 42px);
    font-weight: 800;
    margin-bottom: 16px;
    letter-spacing: -0.02em;
  }
  .cta-inner p {
    font-size: 18px;
    color: rgba(255, 255, 255, 0.8);
    max-width: 600px;
    margin: 0 auto 32px;
  }
  .cta-btns {
    display: flex;
    justify-content: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  @media (max-width: 600px) {
    .cta-inner { padding: 48px 24px; }
    .cta-btns .btn { width: 100%; justify-content: center; }
  }
</style>
