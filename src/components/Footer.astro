---
<footer class="footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a href="/" class="f-logo">
          <img src="/logo.png" alt="PackersHub Logo" class="f-logo-img" />
          <span class="l-text">PackersHub</span>
        </a>
        <p>South India's most trusted IBA Approved movers. Headquartered in Nellore, serving 75+ cities with 15+ years of excellence.</p>
        <div class="f-contact">
          <a href="tel:+917731074075">📞 +91 77310 74075</a>
          <a href="mailto:info@packershub.in">✉️ info@packershub.in</a>
        </div>
      </div>
      
      <div class="footer-links">
        <h4>Our Services</h4>
        <a href="/#services">Household Shifting</a>
        <a href="/#services">Office Relocation</a>
        <a href="/#services">Car Transport</a>
        <a href="/#services">Bike Transport</a>
      </div>
      
      <div class="footer-links">
        <h4>Popular States</h4>
        <a href="/#locations">Andhra Pradesh</a>
        <a href="/#locations">Telangana</a>
        <a href="/#locations">Tamil Nadu</a>
        <a href="/#locations">Karnataka</a>
      </div>
      
      <div class="footer-links">
        <h4>Quick Links</h4>
        <a href="/#faq">Common FAQ</a>
        <a href="/#pricing">Moving Rates</a>
        <a href="/#reviews">Testimonials</a>
        <a href="/#locations">All 75 Cities</a>
      </div>
    </div>
    
    <div class="footer-bottom">
      <p>© 2025 PackersHub. All Rights Reserved.</p>
      <div class="b-links">
        <a href="#">Privacy Policy</a>
        <a href="#">Terms & Conditions</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer { background: #0A0F1E; padding: 80px 0 40px; color: rgba(255, 255, 255, 0.6); }
  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 48px;
    margin-bottom: 64px;
  }
  .f-logo {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    margin-bottom: 24px;
  }
  .f-logo-img {
    width: 32px;
    height: 32px;
    object-fit: contain;
  }
  .l-text {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 800;
    color: #fff;
  }
  .footer-brand p {
    font-size: 14px;
    line-height: 1.7;
    margin-bottom: 24px;
    max-width: 320px;
  }
  .f-contact { display: flex; flex-direction: column; gap: 12px; }
  .f-contact a {
    color: #fff;
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
  }
  
  .footer-links h4 {
    color: #fff;
    font-family: var(--font-display);
    font-size: 16px;
    font-weight: 700;
    margin-bottom: 24px;
  }
  .footer-links { display: flex; flex-direction: column; gap: 14px; }
  .footer-links a {
    color: rgba(255, 255, 255, 0.5);
    text-decoration: none;
    font-size: 14px;
    transition: color 0.2s;
  }
  .footer-links a:hover { color: #fff; }
  
  .footer-bottom {
    padding-top: 32px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 13px;
  }
  .b-links { display: flex; gap: 24px; }
  .b-links a { color: rgba(255, 255, 255, 0.4); text-decoration: none; }

  @media (max-width: 992px) {
    .footer-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 600px) {
    .footer-grid { grid-template-columns: 1fr; gap: 40px; }
    .footer-bottom { flex-direction: column; gap: 16px; text-align: center; }
  }
</style>
