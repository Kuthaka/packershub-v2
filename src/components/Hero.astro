---
---
<section class="city-hero">
  <div class="container">
    <div class="city-hero-grid">
      <div class="animate-fadeUp">
        <div class="city-badge">
          <span style="width:8px;height:8px;background:#16A34A;border-radius:50%;display:inline-block;"></span>
          South India's #1 Movers · 15+ Years
        </div>
        <h1>
          Relocate with<br>
          the <span class="hl">Experts</span>
        </h1>
        <p>IBA Approved movers serving 75+ cities across AP, TS, TN, KA & Kerala. Professional household shifting, office relocation, and vehicle transport with zero damage guarantee.</p>
        
        <div class="city-cta">
          <a href="tel:+917731074075" class="btn btn-primary btn-lg">📞 Get FREE Quote</a>
          <a href="https://wa.me/917731074075" class="btn btn-accent btn-lg" target="_blank">💬 WhatsApp</a>
        </div>
        
        <div class="trust-pills">
          <span class="trust-pill">✅ IBA Approved</span>
          <span class="trust-pill">⭐ 4.9★ Rated</span>
          <span class="trust-pill">🛡 100% Insured</span>
          <span class="trust-pill">💰 From ₹3,999</span>
        </div>
      </div>

      <div class="animate-fadeUp" style="animation-delay: 0.2s;">
        <div class="quote-card">
          <div class="q-title">⚡ Get FREE Moving Quote</div>
          <div class="q-sub">Instant response · No commitment · 100% free</div>
          <form id="heroQuoteForm">
            <div class="form-row">
              <div class="form-group">
                <label>Moving From</label>
                <input type="text" name="from" placeholder="Source City" required>
              </div>
              <div class="form-group">
                <label>Moving To</label>
                <input type="text" name="to" placeholder="Destination City" required>
              </div>
            </div>
            <div class="form-group">
              <label>Service Type</label>
              <select name="service" required>
                <option value="">Select Service</option>
                <option>Household Shifting</option>
                <option>Office Relocation</option>
                <option>Car Transport</option>
                <option>Bike Transport</option>
                <option>Storage</option>
              </select>
            </div>
            <div class="form-row">
              <div class="form-group">
                <label>Moving Floor From</label>
                <select name="floor_from" required>
                  <option>Ground Floor</option>
                  <option>1st Floor</option>
                  <option>2nd Floor</option>
                  <option>3rd Floor</option>
                  <option>4th Floor</option>
                  <option>5th+ Floor</option>
                </select>
              </div>
              <div class="form-group">
                <label>Moving Floor To</label>
                <select name="floor_to" required>
                  <option>Ground Floor</option>
                  <option>1st Floor</option>
                  <option>2nd Floor</option>
                  <option>3rd Floor</option>
                  <option>4th Floor</option>
                  <option>5th+ Floor</option>
                </select>
              </div>
            </div>
            <div class="form-row">
              <div class="form-group">
                <label>Your Name</label>
                <input type="text" name="name" placeholder="Full Name" required>
              </div>
              <div class="form-group">
                <label>Phone Number</label>
                <input type="tel" name="phone" placeholder="+91 XXXXXXXXXX" required>
              </div>
            </div>
            <button type="submit" class="btn btn-primary submit-btn">🚀 Get My FREE Quote Now</button>
          </form>
          <div class="form-note">🔒 Safe & Confidential · No spam</div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .city-hero {
    background: linear-gradient(135deg, #EEF3FF 0%, #F4F7FE 60%, #FFFBF5 100%);
    padding: 100px 0 80px;
    position: relative;
    overflow: hidden;
  }
  .city-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='%231B4FD8' fill-opacity='0.04'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/svg%3E");
    opacity: 0.5;
  }
  .city-hero-grid {
    display: grid;
    grid-template-columns: 1fr 420px;
    gap: 60px;
    align-items: center;
    position: relative;
    z-index: 1;
  }
  
  .city-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #fff;
    border: 1.5px solid var(--border);
    padding: 8px 16px;
    border-radius: 100px;
    font-size: 13px;
    font-weight: 600;
    color: var(--text-secondary);
    box-shadow: 0 2px 8px rgba(27,79,216,0.08);
    margin-bottom: 24px;
  }
  
  .city-hero h1 {
    font-family: var(--font-display);
    font-size: clamp(32px, 5vw, 64px);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.025em;
    margin-bottom: 24px;
    color: var(--text-primary);
  }
  .city-hero h1 .hl { color: var(--primary); }
  
  .city-hero p {
    font-size: 18px;
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: 40px;
    max-width: 540px;
  }
  
  .city-cta {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 40px;
  }
  
  .trust-pills {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }
  .trust-pill {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 600;
    color: var(--text-secondary);
  }

  /* QUOTE CARD */
  .quote-card {
    background: #fff;
    border-radius: 28px;
    box-shadow: 0 24px 80px rgba(27,79,216,0.18);
    padding: 32px;
    border: 1px solid var(--border);
    position: relative;
  }
  .quote-card::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 28px;
    right: 28px;
    height: 4px;
    background: linear-gradient(90deg, var(--primary), var(--accent));
    border-radius: 0 0 4px 4px;
  }
  .q-title {
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 800;
    margin-bottom: 6px;
    color: var(--text-primary);
  }
  .q-sub {
    font-size: 13px;
    color: var(--text-muted);
    margin-bottom: 24px;
  }
  
  .form-group { margin-bottom: 16px; }
  .form-group label {
    display: block;
    font-size: 11px;
    font-weight: 700;
    color: var(--text-secondary);
    margin-bottom: 6px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .form-group select, .form-group input {
    width: 100%;
    padding: 12px 16px;
    border: 1.5px solid var(--border);
    border-radius: var(--radius-sm);
    font-family: var(--font-body);
    font-size: 14px;
    outline: none;
    transition: var(--transition);
    background: var(--bg);
  }
  .form-group select:focus, .form-group input:focus {
    border-color: var(--primary);
    box-shadow: 0 0 0 3px rgba(27,79,216,0.1);
  }
  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .submit-btn {
    width: 100%;
    justify-content: center;
    margin-top: 8px;
    font-size: 16px;
    border-radius: 12px;
    padding: 16px;
  }
  .form-note {
    text-align: center;
    font-size: 12px;
    color: var(--text-muted);
    margin-top: 12px;
  }

  @media (max-width: 992px) {
    .city-hero-grid { grid-template-columns: 1fr; gap: 48px; }
    .city-hero { padding: 60px 0; text-align: center; }
    .city-hero p { margin: 0 auto 40px; }
    .city-cta, .trust-pills { justify-content: center; }
    .quote-card { max-width: 480px; margin: 0 auto; }
  }
  
  @media (max-width: 480px) {
    .form-row { grid-template-columns: 1fr; gap: 0; }
  }
</style>

<script>
  const form = document.getElementById('heroQuoteForm');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const btn = form.querySelector('.submit-btn') as HTMLElement;
    if (btn) {
      const originalText = btn.innerHTML;
      btn.innerHTML = '✅ Quote Sent! Redirecting...';
      btn.style.background = '#16A34A';
      setTimeout(() => {
        btn.innerHTML = originalText;
        btn.style.background = '';
        (form as HTMLFormElement).reset();
      }, 3000);
    }
  });
</script>
