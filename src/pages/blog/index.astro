---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FloatingActions from '../../components/FloatingActions.astro';
import { getBlogPosts, urlFor } from '../../sanity/api';

const posts = await getBlogPosts();
const featuredPost = posts.find(p => p.featured) || posts[0];
const regularPosts = posts.filter(p => p._id !== featuredPost?._id);
---

<Layout title="Blog | PackersHub - Expert Moving Tips & Guides">
	<Header />
	<main>
		<!-- Blog Hero -->
		<section class="blog-hero">
			<div class="container">
				<div class="hero-content animate-fadeUp">
					<div class="chip">📚 Expert Insights</div>
					<h1 class="heading-lg">Moving <span class="text-gradient">Knowledge.</span></h1>
					<p class="hero-desc">
						The latest guides, neighborhood reviews, and expert advice to make your next move the smoothest one yet.
					</p>
				</div>
			</div>
		</section>

		<!-- Featured Post -->
		{featuredPost && (
			<section class="featured-section">
				<div class="container">
					<a href={`/blog/${featuredPost.slug.current}`} class="featured-card animate-fadeUp">
						<div class="featured-image">
							<img src={featuredPost.mainImage ? urlFor(featuredPost.mainImage).url() : 'https://placehold.co/1200x800/1B4FD8/ffffff?text=PackersHub'} alt={featuredPost.title} />
							<div class="post-badge">Featured Article</div>
						</div>
						<div class="featured-content">
							<div class="post-meta">
								{featuredPost.categories?.map(cat => (
									<span class="category">{cat.title}</span>
								))}
								<span class="dot">•</span>
								<span class="read-time">{featuredPost.readTime} min read</span>
							</div>
							<h2 class="featured-title">{featuredPost.title}</h2>
							<p class="featured-excerpt">{featuredPost.excerpt}</p>
							<div class="post-author">
								<img src={featuredPost.author.image ? urlFor(featuredPost.author.image).url() : 'https://placehold.co/100x100/1B4FD8/ffffff?text=PH'} alt={featuredPost.author.name} />
								<div>
									<div class="author-name">{featuredPost.author.name}</div>
									<div class="post-date">{new Date(featuredPost.publishedAt).toLocaleDateString('en-IN', { month: 'long', day: 'numeric', year: 'numeric' })}</div>
								</div>
							</div>
						</div>
					</a>
				</div>
			</section>
		)}

		<!-- Post Grid -->
		<section class="posts-section">
			<div class="container">
				<div class="section-header animate-fadeUp">
					<div class="chip">Latest Updates</div>
					<h2>Recent <span class="text-gradient">Articles</span></h2>
				</div>
				<div class="blog-grid">
					{regularPosts.map((post, index) => (
						<a href={`/blog/${post.slug.current}`} class="blog-card animate-fadeUp" style={`animation-delay: ${0.1 * (index % 3)}s;`}>
							<div class="card-image">
								<img src={post.mainImage ? urlFor(post.mainImage).url() : 'https://placehold.co/600x400/1B4FD8/ffffff?text=PackersHub'} alt={post.title} />
							</div>
							<div class="card-content">
								<div class="post-meta">
									{post.categories?.[0] && <span class="category">{post.categories[0].title}</span>}
									<span class="dot">•</span>
									<span class="read-time">{post.readTime} min read</span>
								</div>
								<h3 class="card-title">{post.title}</h3>
								<p class="card-excerpt">{post.excerpt}</p>
								<div class="card-footer">
									<div class="author-info">
										<img src={post.author.image ? urlFor(post.author.image).url() : 'https://placehold.co/100x100/1B4FD8/ffffff?text=PH'} alt={post.author.name} />
										<span>{post.author.name}</span>
									</div>
									<span class="arrow">→</span>
								</div>
							</div>
						</a>
					))}
				</div>
			</div>
		</section>
	</main>
	<Footer />
	<FloatingActions />
</Layout>

<style>
	.blog-hero {
		padding: 120px 0 140px;
		background: var(--primary-light);
		position: relative;
		overflow: hidden;
	}
	.blog-hero::before {
		content: '';
		position: absolute;
		inset: 0;
		background: radial-gradient(circle at 70% 30%, rgba(27, 79, 216, 0.05), transparent 50%);
	}
	.hero-content { position: relative; z-index: 1; text-align: center; max-width: 800px; margin: 0 auto; }
	.hero-desc { color: var(--text-secondary); font-size: 1.1rem; line-height: 1.6; margin-top: 20px; }

	.featured-section { margin-top: -80px; position: relative; z-index: 10; }
	.featured-card {
		display: grid;
		grid-template-columns: 1.2fr 1fr;
		background: #fff;
		border-radius: var(--radius-lg);
		overflow: hidden;
		box-shadow: var(--shadow-lg);
		transition: var(--transition);
		border: 1px solid var(--border);
	}
	.featured-card:hover { transform: translateY(-8px); border-color: var(--primary); }
	.featured-image { position: relative; height: 480px; }
	.featured-image img { width: 100%; height: 100%; object-fit: cover; }
	.post-badge { position: absolute; top: 24px; left: 24px; background: var(--primary); color: #fff; padding: 6px 16px; border-radius: 100px; font-weight: 700; font-size: 12px; text-transform: uppercase; letter-spacing: 0.05em; }
	
	.featured-content { padding: 60px; display: flex; flex-direction: column; justify-content: center; }
	.post-meta { display: flex; align-items: center; gap: 12px; margin-bottom: 20px; }
	.category { color: var(--primary); font-weight: 700; font-size: 13px; text-transform: uppercase; letter-spacing: 0.05em; }
	.dot { color: var(--border); }
	.read-time { color: var(--text-secondary); font-size: 14px; }
	.featured-title { font-family: var(--font-display); font-size: 2.8rem; line-height: 1.1; color: var(--text-primary); margin-bottom: 20px; }
	.featured-excerpt { color: var(--text-secondary); font-size: 1.1rem; line-height: 1.7; margin-bottom: 32px; }
	
	.post-author { display: flex; align-items: center; gap: 16px; }
	.post-author img { width: 48px; height: 48px; border-radius: 50%; object-fit: cover; border: 2px solid var(--primary-light); }
	.author-name { font-weight: 700; color: var(--text-primary); }
	.post-date { font-size: 13px; color: var(--text-secondary); }

	.posts-section { padding: 100px 0; background: #fff; }
	.section-header { text-align: center; margin-bottom: 60px; }
	.blog-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 30px; }
	.blog-card { background: #fff; border-radius: var(--radius-lg); overflow: hidden; border: 1.5px solid var(--border); transition: var(--transition); }
	.blog-card:hover { transform: translateY(-8px); border-color: var(--primary); box-shadow: var(--shadow-md); }
	.card-image { height: 240px; overflow: hidden; }
	.card-image img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s; }
	.blog-card:hover .card-image img { transform: scale(1.05); }
	
	.card-content { padding: 24px; }
	.card-title { font-family: var(--font-display); font-size: 1.4rem; color: var(--text-primary); margin-bottom: 12px; line-height: 1.3; }
	.card-excerpt { color: var(--text-secondary); font-size: 14px; line-height: 1.6; margin-bottom: 24px; height: 3.2rem; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
	
	.card-footer { display: flex; align-items: center; justify-content: space-between; padding-top: 20px; border-top: 1px solid var(--border); }
	.author-info { display: flex; align-items: center; gap: 10px; font-size: 13px; font-weight: 600; color: var(--text-primary); }
	.author-info img { width: 32px; height: 32px; border-radius: 50%; object-fit: cover; }
	.arrow { font-size: 20px; color: var(--primary); transition: transform 0.3s; }
	.blog-card:hover .arrow { transform: translateX(5px); }

	@media (max-width: 1024px) {
		.featured-card { grid-template-columns: 1fr; }
		.featured-image { height: 350px; }
		.blog-grid { grid-template-columns: repeat(2, 1fr); }
		.featured-title { font-size: 2.2rem; }
	}
	@media (max-width: 768px) {
		.blog-hero { padding: 100px 0 80px; }
		.blog-grid { grid-template-columns: 1fr; }
		.featured-content { padding: 30px; }
		.featured-title { font-size: 1.8rem; }
	}
</style>
