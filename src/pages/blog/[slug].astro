---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FloatingActions from '../../components/FloatingActions.astro';
import { getBlogPosts, getBlogPostBySlug, urlFor } from '../../sanity/api';
import { PortableText } from 'astro-portabletext';

export async function getStaticPaths() {
	const posts = await getBlogPosts();
	return posts.map(post => ({
		params: { slug: post.slug.current }
	}));
}

const { slug } = Astro.params;
const post = await getBlogPostBySlug(slug);

if (!post) return Astro.redirect('/404');

const publishedDate = new Date(post.publishedAt).toLocaleDateString('en-IN', {
	month: 'long',
	day: 'numeric',
	year: 'numeric'
});
---

<Layout title={`${post.title} | PackersHub Blog`}>
	<Header />
	<main>
		<!-- Post Header -->
		<article class="post-container">
			<header class="post-header">
				<div class="container narrow">
					<div class="post-header-content animate-fadeUp">
						<div class="post-meta-top">
							{post.categories?.map(cat => (
								<span class="category-badge">{cat.title}</span>
							))}
							<span class="dot">•</span>
							<span class="read-time">{post.readTime} min read</span>
						</div>
						<h1 class="post-title">{post.title}</h1>
						<p class="post-excerpt">{post.excerpt}</p>
						
						<div class="post-author-box">
							<img src={post.author.image ? urlFor(post.author.image).url() : 'https://placehold.co/100x100/1B4FD8/ffffff?text=PH'} alt={post.author.name} />
							<div class="author-details">
								<div class="name">{post.author.name}</div>
								<div class="role">{post.author.role}</div>
							</div>
							<div class="divider"></div>
							<div class="date-box">
								<div class="label">Published</div>
								<div class="val">{publishedDate}</div>
							</div>
						</div>
					</div>
				</div>
			</header>

			<!-- Featured Image -->
			<div class="container">
				<div class="main-image animate-fadeUp" style="animation-delay: 0.2s;">
					<img src={post.mainImage ? urlFor(post.mainImage).url() : 'https://placehold.co/1200x800/1B4FD8/ffffff?text=PackersHub'} alt={post.title} />
				</div>
			</div>

			<!-- Post Body -->
			<div class="container narrow">
				<div class="post-body">
					{post.body && <PortableText value={post.body} />}
				</div>

				<!-- Share & Tags -->
				<footer class="post-footer animate-fadeUp">
					<div class="tags">
						{post.categories?.map(cat => (
							<span class="tag">#{cat.title.toLowerCase().replace(' ', '')}</span>
						))}
					</div>
					<div class="share-box">
						<span>Share article:</span>
						<div class="share-links">
							<a href={`https://twitter.com/intent/tweet?text=${post.title}&url=${Astro.url}`} target="_blank">𝕏</a>
							<a href={`https://www.linkedin.com/sharing/share-offsite/?url=${Astro.url}`} target="_blank">in</a>
							<a href={`https://wa.me/?text=${post.title}%20${Astro.url}`} target="_blank">💬</a>
						</div>
					</div>
				</footer>

				<!-- Author Bio -->
				<section class="author-bio-card">
					<img src={post.author.image ? urlFor(post.author.image).url() : 'https://placehold.co/100x100/1B4FD8/ffffff?text=PH'} alt={post.author.name} />
					<div class="bio-content">
						<h3>About {post.author.name}</h3>
						<div class="bio-text">
							{post.author.bio && <PortableText value={post.author.bio} />}
						</div>
					</div>
				</section>
			</div>

			<!-- Related Posts -->
			{post.relatedPosts && post.relatedPosts.length > 0 && (
				<section class="related-posts">
					<div class="container">
						<div class="section-header center animate-fadeUp">
							<div class="chip">More Guides</div>
							<h2>You Might Also <span class="text-gradient">Like</span></h2>
						</div>
						<div class="related-grid">
							{post.relatedPosts.map(rel => (
								<a href={`/blog/${rel.slug.current}`} class="blog-card">
									<div class="card-image">
										<img src={rel.mainImage ? urlFor(rel.mainImage).url() : 'https://placehold.co/600x400/1B4FD8/ffffff?text=PackersHub'} alt={rel.title} />
									</div>
									<div class="card-content">
										<h3 class="card-title">{rel.title}</h3>
										<span class="arrow">Read Story →</span>
									</div>
								</a>
							))}
						</div>
					</div>
				</section>
			)}
		</article>
	</main>
	<Footer />
	<FloatingActions />
</Layout>

<style>
	.post-container { padding: 120px 0 100px; background: #fff; }
	.container.narrow { max-width: 860px; }
	
	.post-header { text-align: center; margin-bottom: 60px; }
	.post-meta-top { display: flex; align-items: center; justify-content: center; gap: 12px; margin-bottom: 24px; }
	.category-badge { background: var(--primary-light); color: var(--primary); padding: 6px 14px; border-radius: 100px; font-weight: 700; font-size: 12px; text-transform: uppercase; letter-spacing: 0.05em; }
	.post-title { font-family: var(--font-display); font-size: clamp(2.2rem, 5vw, 3.8rem); line-height: 1.1; color: var(--text-primary); margin-bottom: 24px; }
	.post-excerpt { font-size: 1.25rem; color: var(--text-secondary); line-height: 1.6; max-width: 700px; margin: 0 auto 40px; }
	
	.post-author-box { display: flex; align-items: center; justify-content: center; gap: 24px; background: var(--bg-section); padding: 16px 32px; border-radius: 100px; width: fit-content; margin: 0 auto; border: 1.5px solid var(--border); }
	.post-author-box img { width: 44px; height: 44px; border-radius: 50%; object-fit: cover; border: 2px solid #fff; }
	.author-details { text-align: left; }
	.author-details .name { font-weight: 700; color: var(--text-primary); font-size: 15px; }
	.author-details .role { font-size: 12px; color: var(--text-secondary); }
	.divider { width: 1px; height: 30px; background: var(--border); }
	.date-box { text-align: left; }
	.date-box .label { font-size: 10px; text-transform: uppercase; color: var(--text-secondary); font-weight: 700; }
	.date-box .val { font-size: 14px; color: var(--text-primary); font-weight: 600; }

	.main-image { margin-bottom: 80px; border-radius: var(--radius-lg); overflow: hidden; box-shadow: var(--shadow-lg); height: 520px; border: 1px solid var(--border); }
	.main-image img { width: 100%; height: 100%; object-fit: cover; }

	.post-body { font-size: 1.15rem; line-height: 1.8; color: #1a1a1a; }
	.post-body :global(h2) { font-family: var(--font-display); font-size: 2.2rem; color: var(--text-primary); margin: 60px 0 24px; line-height: 1.2; }
	.post-body :global(h3) { font-family: var(--font-display); font-size: 1.6rem; color: var(--text-primary); margin: 40px 0 20px; line-height: 1.2; }
	.post-body :global(p) { margin-bottom: 24px; }
	.post-body :global(ul) { margin-bottom: 32px; padding-left: 20px; list-style: disc; }
	.post-body :global(li) { margin-bottom: 12px; }
	.post-body :global(strong) { color: var(--text-primary); font-weight: 700; }

	.post-footer { margin-top: 60px; padding-top: 40px; border-top: 1px solid var(--border); display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 24px; }
	.tags { display: flex; gap: 10px; }
	.tag { color: var(--primary); font-size: 14px; font-weight: 600; }
	.share-box { display: flex; align-items: center; gap: 16px; font-size: 14px; color: var(--text-secondary); }
	.share-links { display: flex; gap: 10px; }
	.share-links a { width: 36px; height: 36px; border-radius: 50%; background: var(--bg-section); display: flex; align-items: center; justify-content: center; color: var(--text-primary); font-weight: 700; transition: var(--transition); border: 1.5px solid var(--border); text-decoration: none; }
	.share-links a:hover { border-color: var(--primary); color: var(--primary); transform: translateY(-3px); }

	.author-bio-card { margin-top: 80px; background: var(--bg-section); padding: 40px; border-radius: var(--radius-lg); display: flex; gap: 32px; border: 1.5px solid var(--border); }
	.author-bio-card img { width: 100px; height: 100px; border-radius: 24px; object-fit: cover; flex-shrink: 0; border: 3px solid #fff; }
	.bio-content h3 { font-family: var(--font-display); font-size: 1.5rem; color: var(--text-primary); margin-bottom: 12px; }
	.bio-text { font-size: 15px; color: var(--text-secondary); line-height: 1.6; }

	.related-posts { padding: 100px 0; background: var(--bg-section); margin-top: 100px; }
	.section-header.center { text-align: center; margin-bottom: 50px; }
	.related-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
	.blog-card { background: #fff; border-radius: 20px; overflow: hidden; border: 1.5px solid var(--border); transition: var(--transition); text-decoration: none; }
	.blog-card:hover { transform: translateY(-8px); border-color: var(--primary); box-shadow: var(--shadow-md); }
	.card-image { height: 180px; overflow: hidden; }
	.card-image img { width: 100%; height: 100%; object-fit: cover; }
	.card-content { padding: 20px; }
	.card-title { font-family: var(--font-display); font-size: 1.1rem; color: var(--text-primary); margin-bottom: 12px; line-height: 1.4; }
	.arrow { color: var(--primary); font-size: 13px; font-weight: 700; }

	@media (max-width: 768px) {
		.post-container { padding: 100px 0 60px; }
		.post-author-box { flex-direction: column; padding: 24px; border-radius: 24px; gap: 12px; }
		.divider { width: 40px; height: 1px; }
		.author-details, .date-box { text-align: center; }
		.main-image { height: 320px; margin-bottom: 40px; }
		.author-bio-card { flex-direction: column; text-align: center; align-items: center; padding: 30px 20px; }
		.related-grid { grid-template-columns: 1fr; }
		.post-title { font-size: 2.2rem; }
	}
</style>
